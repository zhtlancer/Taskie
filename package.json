{
  "name": "homework-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "小学生日常作业任务管理系统 (Vue 3 + Fastify + SQLite，针对 iPad Air 5 横屏深度优化)",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev": "npm run dev:frontend",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:backend && npm run test:frontend",
    "test:browser": "node scripts/smoke-browser.cjs",
    "test:docker-data": "node scripts/smoke-docker-data.cjs",
    "test:upgrade": "node scripts/test-upgrade.cjs",
    "test:browser:time-stats": "node scripts/smoke-time-stats.cjs",
    "test:browser:carry-over": "node scripts/smoke-carry-over.cjs",
    "test:browser:homework": "node scripts/smoke-homework.cjs",
    "test:browser:ui-refine": "node scripts/smoke-ui-refine.cjs",
    "seed:backend": "npm --prefix backend run seed",
    "test:browser:midnight": "node scripts/smoke-midnight.cjs",
    "test:browser:legacy": "node scripts/smoke-legacy.cjs",
    "test:browser:dialogs": "node scripts/smoke-dialogs.cjs",
    "test:browser:class-stats": "node scripts/smoke-class-stats.cjs",
    "test:browser:class-count": "node scripts/smoke-class-count.cjs",
    "test:browser:running-timer": "node scripts/smoke-running-timer.cjs",
    "test:browser:rest": "node scripts/smoke-rest.cjs",
    "test:browser:photo-backup": "node scripts/smoke-photo-backup.cjs",
    "test:browser:photo-export": "node scripts/smoke-photo-export.cjs",
    "test:backup-performance": "node scripts/smoke-backup-performance.cjs",
    "test:browser:frontend-recovery": "node scripts/smoke-review2-frontend.cjs",
    "check:repo": "node scripts/check-repo-content.cjs"
  }
}
